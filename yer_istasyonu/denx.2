    def toggle_follow(self):
        self.follow_mode = not self.follow_mode
        self.map_view.page().runJavaScript(f"window.setFollowMode({str(self.follow_mode).lower()});")
        self.log_message(f"FOLLOW: {'ON' if self.follow_mode else 'OFF'}")

    def clear_mission_everywhere(self):
        self.current_waypoints.clear()
        self.lbl_wp_count.setText(f"Noktalar: 0/{MAX_WAYPOINTS}")
        self.map_view.page().runJavaScript("window.suppressBridge=true; window.clearMission();")
        QTimer.singleShot(300, lambda: self.map_view.page().runJavaScript("window.suppressBridge=false;"))
        self.log_message("Mission temizlendi.")

    def confirm_kill(self):
        ret = QMessageBox.question(
            self,
            "ACİL KILL",
            f"Araç gücü kesilsin mi?\nCH{KILL_SERVO_CHANNEL} -> PWM {KILL_PWM}",
            QMessageBox.Yes | QMessageBox.No,
        )
        if ret == QMessageBox.Yes:
            self.ida_thread.kill_power()

    def update_graphs(self):
        if self.speed_history:
            self.curve_speed.setData(list(range(len(self.speed_history))), list(self.speed_history))

    @pyqtSlot(float, float, float, float, float, float, float, str, str, float, float)
    def on_ida_telemetry(self, lat, lon, speed, alt, roll, pitch, yaw, mode, arm, yon_sp, hiz_sp):
        self.lbl_ida_mode.setText(f"Mod: {mode}")
        self.lbl_ida_arm.setText(f"Durum: {arm}")
        self.lbl_ida_speed.setText(f"Hız: {speed:.1f} m/s")
        self.horizon_ida.update_attitude(roll, pitch)

        self.speed_history.append(speed)

        if self.log_csv:
            self.log_csv.writerow([time.time(), lat, lon, speed, yaw, mode, arm, self.last_vbat])

        now = time.time()
        if now - self.last_map_js_ida >= 0.2:
            self.map_view.page().runJavaScript(
                f"window.updateIdaPosition({lat}, {lon}, {yaw}, {speed}, '{mode}');"
            )
            self.last_map_js_ida = now

    @pyqtSlot(float, int, int, int)
    def on_ida_health(self, voltage, battery, gps_fix, satellites):
        self.last_vbat = voltage
        self.lbl_ida_battery.setText(f"Batarya: {battery}% ({voltage:.1f}V) | GPS:{gps_fix} SAT:{satellites}")

    @pyqtSlot(float, float, float, float, float, float, float, str, str, float, float)
    def on_iha_telemetry(self, lat, lon, speed, alt, roll, pitch, yaw, mode, arm, yon_sp, hiz_sp):
        now = time.time()
        if now - self.last_map_js_iha >= 0.2:
            self.map_view.page().runJavaScript(
                f"window.updateIhaPosition({lat}, {lon}, {yaw}, {alt}, '{mode}');"
            )
            self.last_map_js_iha = now

    @pyqtSlot(str)
    def on_iha_statustext(self, text: str):
        self.log_message(f"[İHA] {text}")

    @pyqtSlot(str)
    def on_ida_statustext(self, text: str):
        self.log_message(f"[İDA] {text}")

    @pyqtSlot(float, float, int)
    def on_waypoint_added(self, lat: float, lon: float, idx: int):
        if len(self.current_waypoints) >= MAX_WAYPOINTS:
            return
        self.current_waypoints.append(Waypoint(seq=idx, latitude=lat, longitude=lon))
        self.lbl_wp_count.setText(f"Noktalar: {len(self.current_waypoints)}/{MAX_WAYPOINTS}")

    def create_new_mission(self):
        name, ok = QInputDialog.getText(self, "Mission", "Adı:")
        if ok and name:
            if self.mission_manager.create_mission(name):
                self._refresh_mission_list()
                self.log_message(f"Mission oluşturuldu: {name}")
            else:
                QMessageBox.warning(self, "Hata", "Bu mission adı zaten var.")

    def load_mission_to_map(self):
        m = self.mission_manager.get_mission(self.mission_combo.currentText())
        if not m:
            return

        self.current_waypoints.clear()
        self.map_view.page().runJavaScript("window.suppressBridge=true; window.clearMission();")

        for wp in m.waypoints[:MAX_WAYPOINTS]:
            self.current_waypoints.append(wp)
            self.map_view.page().runJavaScript(f"window.addMissionWaypoint({wp.latitude}, {wp.longitude});")

        QTimer.singleShot(400, lambda: self.map_view.page().runJavaScript("window.suppressBridge=false;"))

        self.lbl_wp_count.setText(f"Noktalar: {len(self.current_waypoints)}/{MAX_WAYPOINTS}")
        self.log_message(f"Görev yüklendi: {m.name}")

    def export_csv_mission(self):
        name = self.mission_combo.currentText()
        if name:
            file, _ = QFileDialog.getSaveFileName(self, "Kaydet", "", "CSV (*.csv)")
            if file:
                if self.mission_manager.export_csv(name, file):
                    self.log_message(f"CSV export: {file}")
                else:
                    QMessageBox.warning(self, "Hata", "Export başarısız.")

    def send_mission_to_ida(self):
        if not self.current_waypoints:
            QMessageBox.warning(self, "Hata", "Waypoint yok.")
            return
        self.ida_thread.send_waypoint_mission(self.current_waypoints)

    def _refresh_mission_list(self):
        self.mission_combo.clear()
        self.mission_combo.addItems(self.mission_manager.list_missions())

    def log_message(self, msg: str):
        self.log_text.append(f"[{datetime.now().strftime('%H:%M:%S')}] {msg}")
        self.log_text.verticalScrollBar().setValue(self.log_text.verticalScrollBar().maximum())

    def closeEvent(self, event):
        self.flush_timer.stop()
        self.ida_thread.disconnect()
        self.iha_thread.disconnect()
        try:
            if self.log_fp:
                self.log_fp.flush()
                self.log_fp.close()
        except Exception:
            pass
        if self.mbtiles_manager:
            self.mbtiles_manager.close()
        event.accept()


